{
  "datasets": [
    {
      "name": "azure_monthly_cost",
      "displayName": "Azure AI Monthly Cost by Component",
      "catalog": "${var.catalog}",
      "config": {
        "version": "1.1",
        "source": "WITH billed AS (SELECT DATE_TRUNC('MONTH', cost_date) AS cost_month, CASE WHEN ai_capability = 'Copilot Studio' THEN 'Copilot Studio (Azure invoice)' WHEN cost_domain = 'Databricks' THEN 'Databricks AI' WHEN cost_domain = 'AI Foundry' AND LOWER(TRIM(spoke)) IN ('automation', 'intelligent automation') THEN 'EtexMate' WHEN cost_domain = 'AI Foundry' THEN 'Azure AI Foundry' WHEN ai_capability = 'GitHub Copilot' THEN 'GitHub Copilot' ELSE 'Other AI invoice' END AS cost_driver, cost_eur FROM ${var.catalog}.gold.ai_foundry_costs_enriched WHERE is_ai = TRUE AND cost_date >= DATE_TRUNC('YEAR', ADD_MONTHS(DATE_TRUNC('MONTH', CURRENT_DATE()), -12)) AND cost_date < DATE_TRUNC('MONTH', CURRENT_DATE())), components AS (SELECT cost_month, cost_driver, SUM(cost_eur) AS cost_eur FROM billed GROUP BY 1, 2), monthly AS (SELECT cost_month, SUM(cost_eur) AS total_eur FROM components GROUP BY 1), comparison AS (SELECT m.cost_month, m.total_eur, p.total_eur AS previous_eur, SUM(m.total_eur) OVER (PARTITION BY YEAR(m.cost_month) ORDER BY m.cost_month) AS total_ytd_eur FROM monthly m LEFT JOIN monthly p ON p.cost_month = ADD_MONTHS(m.cost_month, -1)), component_ytd AS (SELECT cost_month, cost_driver, cost_eur, SUM(cost_eur) OVER (PARTITION BY cost_driver, YEAR(cost_month) ORDER BY cost_month) AS component_ytd_eur FROM components) SELECT c.cost_month, c.cost_driver, c.cost_eur, ROUND(m.total_eur, 2) AS total_eur, ROUND(m.previous_eur, 2) AS previous_eur, ROUND(m.total_ytd_eur, 2) AS total_ytd_eur, ROUND(COALESCE(p.cost_eur, 0), 2) AS component_previous_eur, ROUND(c.component_ytd_eur, 2) AS component_ytd_eur, ROUND(100.0 * (c.cost_eur - COALESCE(p.cost_eur, 0)) / NULLIF(p.cost_eur, 0), 1) AS component_change_pct, ROUND(100.0 * (m.total_eur - m.previous_eur) / NULLIF(m.previous_eur, 0), 1) AS change_pct FROM component_ytd c JOIN comparison m ON c.cost_month = m.cost_month LEFT JOIN components p ON p.cost_driver = c.cost_driver AND p.cost_month = ADD_MONTHS(c.cost_month, -1) WHERE c.cost_month >= ADD_MONTHS(DATE_TRUNC('MONTH', CURRENT_DATE()), -12)",
        "dimensions": [
          {
            "name": "cost_month",
            "expr": "cost_month"
          },
          {
            "name": "cost_driver",
            "expr": "cost_driver"
          }
        ],
        "measures": [
          {
            "name": "total_cost_eur",
            "expr": "SUM(cost_eur)"
          },
          {
            "name": "monthly_total_eur",
            "expr": "MAX(total_eur)"
          },
          {
            "name": "change_pct",
            "expr": "MAX(change_pct)"
          },
          {
            "name": "selected_month_eur",
            "expr": "IF(COUNT(DISTINCT cost_driver) > 1, MAX_BY(total_eur, cost_month), MAX_BY(cost_eur, cost_month))"
          },
          {
            "name": "selected_mom_pct",
            "expr": "IF(COUNT(DISTINCT cost_driver) > 1, MAX_BY(change_pct, cost_month), MAX_BY(component_change_pct, cost_month))"
          },
          {
            "name": "selected_ytd_eur",
            "expr": "IF(COUNT(DISTINCT cost_driver) > 1, MAX_BY(total_ytd_eur, cost_month), MAX_BY(component_ytd_eur, cost_month))"
          },
          {
            "name": "selected_previous_eur",
            "expr": "IF(COUNT(DISTINCT cost_driver) > 1, MAX_BY(previous_eur, cost_month), MAX_BY(component_previous_eur, cost_month))"
          }
        ]
      }
    },
    {
      "name": "azure_cumulative_cost",
      "displayName": "Azure AI Invoice by Day and Component",
      "catalog": "${var.catalog}",
      "config": {
        "version": "1.1",
        "source": "SELECT CAST(cost_date AS DATE) AS cost_date, CASE WHEN ai_capability = 'Copilot Studio' THEN 'Copilot Studio (Azure invoice)' WHEN cost_domain = 'Databricks' THEN 'Databricks AI' WHEN cost_domain = 'AI Foundry' AND LOWER(TRIM(spoke)) IN ('automation', 'intelligent automation') THEN 'EtexMate' WHEN cost_domain = 'AI Foundry' THEN 'Azure AI Foundry' WHEN ai_capability = 'GitHub Copilot' THEN 'GitHub Copilot' ELSE 'Other AI invoice' END AS cost_driver, SUM(cost_eur) AS cost_eur FROM ${var.catalog}.gold.ai_foundry_costs_enriched WHERE is_ai = TRUE AND cost_date <= CURRENT_DATE() GROUP BY 1, 2",
        "dimensions": [
          {
            "name": "cost_date",
            "expr": "cost_date"
          },
          {
            "name": "cost_driver",
            "expr": "cost_driver"
          }
        ],
        "measures": [
          {
            "name": "total_cost_eur",
            "expr": "SUM(cost_eur)"
          }
        ]
      }
    },
    {
      "name": "cost_movements",
      "displayName": "AI Invoice Components and Studio Credit Context",
      "catalog": "${var.catalog}",
      "config": {
        "version": "1.1",
        "source": "WITH classified AS (SELECT CASE WHEN ai_capability = 'Copilot Studio' THEN 'Copilot Studio (Azure invoice)' WHEN cost_domain = 'Databricks' THEN 'Databricks AI' WHEN cost_domain = 'AI Foundry' AND LOWER(TRIM(spoke)) IN ('automation', 'intelligent automation') THEN 'EtexMate' WHEN cost_domain = 'AI Foundry' THEN 'Azure AI Foundry' WHEN ai_capability = 'GitHub Copilot' THEN 'GitHub Copilot' ELSE 'Other AI invoice' END AS cost_driver, cost_date, cost_eur FROM ${var.catalog}.gold.ai_foundry_costs_enriched WHERE cost_date >= ADD_MONTHS(DATE_TRUNC('MONTH', CURRENT_DATE()), -2) AND cost_date < DATE_TRUNC('MONTH', CURRENT_DATE()) AND is_ai = TRUE) SELECT cost_driver, 'Closed-month Azure invoice' AS cost_basis, ROUND(SUM(CASE WHEN cost_date >= ADD_MONTHS(DATE_TRUNC('MONTH', CURRENT_DATE()), -1) THEN cost_eur ELSE 0 END), 2) AS amount_eur, ROUND(SUM(CASE WHEN cost_date >= ADD_MONTHS(DATE_TRUNC('MONTH', CURRENT_DATE()), -1) THEN cost_eur ELSE -cost_eur END), 2) AS change_eur FROM classified GROUP BY cost_driver UNION ALL SELECT 'Copilot Studio (credit equivalent)' AS cost_driver, 'Cumulative credits (not invoiced)' AS cost_basis, ROUND(MEASURE(total_consumption_cost_eur), 2) AS amount_eur, CAST(NULL AS DOUBLE) AS change_eur FROM ${var.catalog}.silver.metric_credit_consumption_v2 WHERE agent_category = 'Copilot Studio'",
        "dimensions": [
          {
            "name": "cost_driver",
            "expr": "cost_driver"
          },
          {
            "name": "cost_basis",
            "expr": "cost_basis"
          }
        ],
        "measures": [
          {
            "name": "amount_eur",
            "expr": "MAX(amount_eur)"
          },
          {
            "name": "change_eur",
            "expr": "MAX(change_eur)"
          }
        ]
      }
    }
  ],
