{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "python .cursor/hooks/session_start.py",
        "timeout": 10
      }
    ],
    "beforeShellExecution": [
      {
        "command": "python .cursor/hooks/protect_shell.py",
        "timeout": 10
      }
    ],
    "beforeReadFile": [
      {
        "command": "python .cursor/hooks/protect_secrets.py",
        "timeout": 10
      }
    ],
    "beforeTabFileRead": [
      {
        "command": "python .cursor/hooks/protect_secrets.py",
        "timeout": 10
      }
    ]
  }
}
